{
  "version": 1,
  "frozen": "2026-11-12",
  "design": {
    "arms": [
      "A",
      "B"
    ],
    "runs_per_arm": 3,
    "A": "today's brief: the recorded briefs/<id>.a.md",
    "B": "graph brief: constraints block + graph_explore mixed packet",
    "fixed": [
      "model",
      "prompt",
      "snapshot",
      "tool permissions",
      "cache conditions"
    ]
  },
  "metric": {
    "claude_processed_input": [
      "input",
      "cache_write",
      "cache_read"
    ],
    "aggregate": "median over scenarios of (1 - median(B runs)/median(A runs))"
  },
  "thresholds": {
    "claude_processed_input_median_saving_min": 0.1,
    "required_evidence_regressions_max": 0,
    "condition_regressions_max": 0,
    "major_finding_regressions_max": 0,
    "wrong_certain_edges_max": 0,
    "budget_overruns_max": 0,
    "resolution_recall_min": 0.7
  },
  "scenarios": [
    {
      "id": "s01",
      "family": "software",
      "language": "rust",
      "repo": "repos/s01",
      "seed": "seeds/s01.json",
      "task": "Prevent duplicate reservations when stock is scarce.",
      "query": "reservation stock",
      "a_brief": "briefs/s01.a.md",
      "required_evidence": [
        "src/inventory.rs#function:reserve",
        "src/inventory.rs"
      ],
      "conditions": [
        "Reject requests exceeding available stock"
      ],
      "major_findings": [
        "Reservation checks stock before decrementing it"
      ],
      "budget": 2400
    },
    {
      "id": "s02",
      "family": "research",
      "language": "python",
      "repo": "repos/s02",
