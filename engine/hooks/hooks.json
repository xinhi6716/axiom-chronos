{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${AXIOM_BIN:-axiom}\" hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${AXIOM_BIN:-axiom}\" hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|PowerShell|Read|AskUserQuestion|Agent|Task|mcp__plugin_chronos_bridge__codex_run|mcp__plugin_chronos_bridge__goal",
        "hooks": [
          {
            "type": "command",
            "command": "\"${AXIOM_BIN:-axiom}\" hook"
          }
        ]
      }
    ]
  }
}
